<?php

/**
 * @file
 * Install, update and uninstall functions for the Cucumber Projects module.
 */

use Drupal\Core\Recipe\Recipe;
use Drupal\Core\Recipe\RecipeRunner;

/**
 * Implements hook_install().
 */
function cucumber_projects_install($is_syncing) {
  // Configuration imports bring their own configuration.
  if (\Drupal::isConfigSyncing()) {
    return;
  }

  // When the module is installed on its own, apply its default recipe. When
  // the default recipe installs the module, the recipe is already applied.
  //
  // The recipe grants the Super Admin and Admin roles access to the
  // projects page and imports the default content, the administration menu
  // link. Content is not configuration, so a config import leaves it alone,
  // as default_content did. Recipes import content that already exists (by
  // UUID) as a no-op, so applying this again, or on a site that imported the
  // same entities with the contrib default_content module, creates no
  // duplicates.
  if (!$is_syncing) {
    RecipeRunner::processRecipe(Recipe::createFromDirectory(__DIR__ . '/recipes/default'));
  }
}
